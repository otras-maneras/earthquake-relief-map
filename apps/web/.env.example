# NO commitear el .env real. Todas las integraciones se degradan si falta su clave.

# --- Núcleo (obligatorio) ---
DATABASE_URL=postgres://centros_acopio:CHANGEME@127.0.0.1:5432/centros_acopio
JWT_SECRET=CHANGEME_genera_una_cadena_larga_aleatoria

# --- Analytics (opcional) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_OPENWEATHER_KEY=

# --- Campañas salientes del panel admin (opcional) ---
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WABA_ID=
KAPSO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Boletín de noticias con IA (opcional) ---
OPENROUTER_API_KEY=
NEWS_CRON_SECRET=

# --- Fuentes de datos externas (opcional) ---
INTERP_AID_KEY=
DANOS_EDIFICIOS_API_URL=
DANOS_EDIFICIOS_API_KEY=
AYUDA_VENEZUELA_API_KEY=
# Ingesta de pacientes de HelpMap; apagada si está vacío.
HELPMAP_PATIENTS_URL=
HELPMAP_INCLUDE_DECEASED=

# URL pública de la API /v1 (enlaces, OpenAPI, status_url). Por defecto: http://localhost:4100/v1
# La página /docs/api se prerrenderiza: define esta variable también en el momento del build.
API_PUBLIC_BASE_URL=
