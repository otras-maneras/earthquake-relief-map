# ── Servidor ─────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgres://chatbots:chatbots@localhost:5432/chatbots

# Protege los endpoints /admin/* (header X-Admin-Key)
ADMIN_API_KEY=change-me-to-a-long-random-string

# ── API de datos del mapa (cualquier backend compatible) ─────────────────
# Ejemplo (apps/web de este monorepo): http://localhost:4100/v1
# Ejemplo propio:   https://hub.ejemplo.org/api/public
DATA_API_BASE_URL=https://api.example.org/v1

# Ruta de búsqueda de personas (PII-segura). Vacío = deshabilita "Buscar familiar"
PERSONAS_SEARCH_PATH=/personas

# ── Marca / textos (sin referencias a AcopioVE) ──────────────────────────
BOT_NAME=Asistente de Emergencia
BOT_SITE_URL=https://mapa.ejemplo.org
BOT_SEARCH_URL=
BOT_WELCOME_INTRO=Te ayudo a obtener información en tiempo real sobre la emergencia.

# WhatsApp: incluir nombre de marca en bienvenida (Telegram suele ir sin marca)
BOT_BRANDED_WELCOME=true

# ── Kapso / WhatsApp ─────────────────────────────────────────────────────
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WABA_ID=
KAPSO_WEBHOOK_SECRET=

# País por defecto al normalizar teléfonos (58 = Venezuela)
DEFAULT_PHONE_COUNTRY=58

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# URL pública del webhook (sin barra final). Ej: https://hooks.ejemplo.org
WEBHOOK_PUBLIC_URL=

# ── Campañas por email (opcional) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_NAME=Equipo de Emergencia
RESEND_FROM_EMAIL=no-reply@ejemplo.org

# ── Ingesta entrante / bandeja (Frente A) ─────────────────────────────────
INBOUND_AUTO_REPLY=true
INBOUND_AUTO_REPLY_TEXT=Recibimos tu mensaje. Referencia: {ref}. Lo revisaremos pronto.

# API que exponga el equipo de mapas para recibir foto/video/documento
INBOX_API_URL=
INBOX_API_KEY=
INBOX_API_KEY_HEADER=X-Inbox-Key
INBOX_FORWARD_REQUIRED=false
INBOX_FORWARD_MULTIPART=false

# ── Baileys / WhatsApp Web alternativo y Antispam ───────────────────────
# Número de teléfono del bot para el botón en los correos electrónicos
WHATSAPP_CONTACT_NUMBER=584121234567

# Límites del lote de envíos para evitar baneos
BROADCAST_BATCH_LIMIT=30
# Tiempo de descanso entre lotes (en milisegundos)
BROADCAST_BATCH_REST_MS=90000
